{# Generic table for non-Sylius adapters; Sylius adapter overrides with its own table hook. #}
<div data-loading="addClass(has-loader-active)" class="advanced-flex-table flex-table has-loader">
    <div class="h-loader-wrapper">
        <div class="loader is-large is-loading"></div>
    </div>
    <div class="flex-table-header">
        {% for field in view.definition.enabledFields %}
            <span class="sylius-table-column-{{ field.name }} is-grow">{{ field.label|trans }}</span>
        {% endfor %}
    </div>
    {% for row in this.resources %}
        <div class="flex-table-item">
            {% for field in view.definition.enabledFields %}
                <div class="flex-table-cell is-media is-grow" data-th="">
                    {# Field rendering delegated to adapter-specific hooks when Sylius is used #}
                    {{ attribute(row, field.path)|default('') }}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
