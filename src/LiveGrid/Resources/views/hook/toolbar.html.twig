<div class="columns flex-table-filter-bar">
    {% if form is not null %}
        {% form_theme form 'UiBundle/Form/gridSearchFormTheme.html.twig' %}
        <div class="column is-four-fifths left">
            <hr class="dropdown-divider is-hidden-tablet" />
            {{ form_start(form, {
                attr: {
                    'data-action': 'submit->live#action:prevent',
                    'data-live-action-param': 'search',
                }
            }) }}
            {{ form_end(form) }}
        </div>
    {% endif %}

    <div class="column right">
        {{ live_grid_hook(this.hook('actions'), {
            this: this,
            view: view,
            resultsPerPage: resultsPerPage,
        }) }}
        {{ component('live_grid:results_per_page_select', {
            resultsPerPage: resultsPerPage,
            resultsPerPageChoices: this.allowedPaginate
        }) }}
    </div>
</div>
